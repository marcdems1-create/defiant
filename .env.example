# WalletConnect Cloud project ID — required for RainbowKit's WalletConnect connector.
# Get one free at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# "testnet" (default, safe) or "mainnet" (real funds — do not flip until the
# deposit/withdraw flow has been reviewed and tested end-to-end on testnet).
NEXT_PUBLIC_NETWORK_MODE=testnet

# Optional: your own RPC endpoints (Alchemy/Infura/etc). Falls back to public
# RPCs if unset, which are rate-limited and unreliable for production use.
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_SEPOLIA=
NEXT_PUBLIC_RPC_BASE_SEPOLIA=
NEXT_PUBLIC_RPC_ARBITRUM_SEPOLIA=

# Fee treasury — receives the deposit/withdrawal fee (see README "Fees").
# Same address is reused across every chain. Fees are DISABLED (no fee
# transfer is ever attempted, no UI shown) until this is set to a real
# 0x address you control. Never set it to the zero address as a way to
# "turn fees off" — just leave it blank.
NEXT_PUBLIC_TREASURY_ADDRESS=

# Postgres connection string for questionnaire response storage (see README
# "Data collection"). Any standard managed Postgres works — Neon and
# Supabase both have a free tier; grab the connection string from their
# dashboard. Run migrations/001_questionnaire_responses.sql against it once
# before this does anything. Leave unset in development if you don't need
# to test the opt-in save path — the rest of the app works fine without it,
# the API route just returns an error if a save is attempted.
DATABASE_URL=

# --- Swap (0x Swap API) — powers the /swap page (USDC <-> stables/CRV/CVX) ---
# NEXT_PUBLIC_ZEROEX_API_KEY is REQUIRED for swap quotes; get one free at
# https://dashboard.0x.org . Without it, /swap renders but shows "not configured".
# NEXT_PUBLIC_ZEROEX_API_KEY=
# The fee is OPTIONAL and OFF unless a recipient is set — taken atomically inside
# the swap tx by 0x (never via custody). Leave unset for fee-free swaps.
# NEXT_PUBLIC_SWAP_FEE_RECIPIENT=
# NEXT_PUBLIC_SWAP_FEE_BPS=50
