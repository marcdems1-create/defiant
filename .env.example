# Public site URL — production is https://openhand.online
NEXT_PUBLIC_SITE_URL=https://openhand.online

# WalletConnect Cloud project ID — required for RainbowKit / Privy WalletConnect.
# Get one free at https://cloud.reown.com. Add https://openhand.online to allowed origins.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Privy app ID — email + passkey embedded wallets for first-time users.
# Public client id (safe in the browser). App settings → Basics → App ID
# (starts with cl or cm). NEVER paste the App Secret here — it is baked
# into the public JS bundle and Privy will crash with "invalid app ID".
# Allowed origins: https://openhand.online and https://www.openhand.online.
# Set to "off" to use RainbowKit only.
NEXT_PUBLIC_PRIVY_APP_ID=cmstzz2zb009k0el4fzr8x8jb

# Onramper public key — card → USDC into the connected wallet (mainnet only).
# Leave unset until Onramper allowlists https://openhand.online. Widget URL
# signing (checkout) is still required by Onramper for production buys.
NEXT_PUBLIC_ONRAMPER_API_KEY=

# "testnet" (default, safe) or "mainnet" (real funds — do not flip until the
# deposit/withdraw flow has been reviewed and tested end-to-end on testnet).
NEXT_PUBLIC_NETWORK_MODE=testnet

# Optional: your own RPC endpoints (Alchemy/Infura/etc). Falls back to public
# RPCs if unset, which are rate-limited and unreliable for production use.
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_SEPOLIA=
NEXT_PUBLIC_RPC_BASE_SEPOLIA=
NEXT_PUBLIC_RPC_ARBITRUM_SEPOLIA=

# Fee treasury — receives the deposit/withdrawal fee (see README "Fees").
# Same address is reused across every chain. Fees are DISABLED (no fee
# transfer is ever attempted, no UI shown) until this is set to a real
# 0x address you control. Never set it to the zero address as a way to
# "turn fees off" — just leave it blank.
NEXT_PUBLIC_TREASURY_ADDRESS=

# Postgres connection string for first-party site analytics (see README
# "Site analytics"). Any standard managed Postgres works — Neon and
# Supabase both have a free tier. Run migrations/002_site_analytics.sql
# against it once before /admin shows counts. Leave unset in development
# if you don't need analytics — the rest of the app works fine without it.
DATABASE_URL=

# Password for /admin (site analytics dashboard). Leave unset to disable
# the admin login entirely. Not linked from the public nav. Visit /admin
# directly after this is set.
ADMIN_PASSWORD=

# --- Optional: fee-on-conversion (0x Swap API) for Frax/Convex deposits ---
# NEXT_PUBLIC_ZEROEX_API_KEY=
# NEXT_PUBLIC_SWAP_FEE_RECIPIENT=
# NEXT_PUBLIC_SWAP_FEE_BPS=50
